import { Button, LineEdit, VerticalBox, HorizontalBox, ScrollView, TabWidget } from "std-widgets.slint";

export struct WordBookInfo {
    id: string,
    name: string,
    description: string,
    word_count: int,
    progress: int,
    is_composite: bool,
    sources: string,
}

export struct BookSourceInfo {
    id: string,
    name: string,
    checked: bool,
}

export struct WordInfo {
    answer: string,
    meanings: string,
    hint_type: string,
}

export struct WordStatsInfo {
    word: string,
    total_count: int,
    correct_count: int,
    wrong_count: int,
    accuracy: float,
    last_seen: string,
    is_weak: bool,
}

export component AppWindow inherits Window {
    title: "英语单词测验 - Recitor";
    preferred-width: 850px;
    preferred-height: 680px;
    background: #121417;
    
    in-out property <bool> show-book-selector: true;
    in-out property <bool> show-quiz: false;
    in-out property <bool> show-management: false;
    in-out property <bool> show-book-manager: false;
    in-out property <bool> book-manager-composite: false;
    in-out property <int> book-manager-edit-index: -1;
    in-out property <string> book-manager-name: "";
    in-out property <string> book-manager-desc: "";
    in-out property <[BookSourceInfo]> book-source-list: [];
    in-out property <string> import-export-status: "";
    
    in-out property <[WordBookInfo]> word-books: [];
    in-out property <int> selected-book-index: -1;
    in-out property <string> current-book-name: "";
    
    // 统计数据
    in-out property <[WordStatsInfo]> word-stats-list: [];
    in-out property <int> book-total-count: 0;
    in-out property <int> book-correct-count: 0;
    in-out property <int> book-wrong-count: 0;
    in-out property <float> book-accuracy: 0.0;
    
    in-out property <[WordInfo]> words-list: [];
    in-out property <int> selected-word-index: -1;
    in-out property <string> edit-answer: "";
    in-out property <string> edit-meanings: "";
    in-out property <string> edit-hint-type: "Meaning";
    
    in-out property <string> current-tip: "选择单词本开始测验";
    in-out property <string> user-input: "";
    in-out property <int> score: 0;
    in-out property <string> feedback: "";
    in-out property <bool> quiz-active: false;
    in-out property <bool> show-feedback: false;
    in-out property <bool> is-correct: false;
    
    callback select-book(int);
    callback manage-book(int);
    callback start-quiz();
    callback submit-answer(string);
    callback next-question();
    callback back-to-books();
    callback back-to-books-from-management();
    callback select-word(int);
    callback save-word();
    callback delete-word(int);
    callback add-new-word();
    callback reset-word-stats(string);
    callback reset-book-stats();
    callback open-book-manager();
    callback close-book-manager();
    callback new-book();
    callback edit-book(int);
    callback save-book();
    callback delete-book(int);
    callback toggle-book-source(int);
    callback reset-all-books();
    callback export-books();
    callback import-books();
    
    VerticalBox {
        padding: 20px;
        spacing: 15px;
        
        // ======== 单词本选择界面 ========
        if show-book-selector: VerticalBox {
            spacing: 20px;
            
            HorizontalBox {
                alignment: space-between;

                Text {
                    text: "请选择单词本";
                    font-size: 28px;
                    font-weight: 700;
                    vertical-alignment: center;
                    color: #E0E0E0;
                }

                Button {
                    text: "管理单词本";
                    clicked => {
                        open-book-manager();
                    }
                }
            }
            
            Text {
                text: "不同的单词本包含不同难度和类型的词汇";
                font-size: 16px;
                horizontal-alignment: center;
                color: #B0B0B0;
            }
            
            Rectangle {
                height: 2px;
                background: #3A3A3A;
            }
            
            ScrollView {
                content-height: word-books.length * 165px;
                
                VerticalBox {
                    spacing: 15px;
                    
                    for book[index] in word-books: Rectangle {
                        height: 150px;
                        border-radius: 12px;
                        background: #20242A;
                        border-width: 2px;
                        border-color: book-touch.has-hover ? #42A5F5 : #E0E0E0;
                        
                        book-touch := TouchArea {
                            HorizontalBox {
                                spacing: 0px;
                                
                                Rectangle {
                                    TouchArea {
                                        clicked => {
                                            select-book(index);
                                        }
                                        
                                        VerticalBox {
                                            padding: 18px;
                                            spacing: 10px;
                                            
                                            HorizontalBox {
                                                alignment: space-between;
                                                
                                                Text {
                                                    text: book.name;
                                                    font-size: 22px;
                                                    font-weight: 700;
                                                    color: #E0E0E0;
                                                }
                                                
                                                HorizontalBox {
                                                    spacing: 8px;

                                                    if book.is_composite: Rectangle {
                                                        width: 56px;
                                                        height: 32px;
                                                        border-radius: 16px;
                                                        background: #2E4A63;
                                                        border-width: 1px;
                                                        border-color: #42A5F5;

                                                        Text {
                                                            text: "组合";
                                                            font-size: 13px;
                                                            font-weight: 600;
                                                            color: #90CAF9;
                                                            vertical-alignment: center;
                                                            horizontal-alignment: center;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 70px;
                                                        height: 32px;
                                                        border-radius: 16px;
                                                        background: #42A5F5;

                                                        Text {
                                                            text: book.word_count + "词";
                                                            font-size: 14px;
                                                            font-weight: 600;
                                                            color: #FFFFFF;
                                                            vertical-alignment: center;
                                                            horizontal-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                            
                                            Text {
                                                text: book.description;
                                                font-size: 15px;
                                                color: #B0B0B0;
                                                wrap: word-wrap;
                                            }

                                            if book.is_composite: Text {
                                                text: "来源：" + book.sources;
                                                font-size: 13px;
                                                color: #90CAF9;
                                                overflow: elide;
                                            }
                                            
                                            Rectangle {
                                                height: 8px;
                                                border-radius: 4px;
                                                background: #E0E0E0;
                                                
                                                Rectangle {
                                                    width: parent.width * book.progress / book.word_count;
                                                    height: parent.height;
                                                    border-radius: 4px;
                                                    background: #66BB6A;
                                                }
                                            }
                                            
                                            HorizontalBox {
                                                alignment: space-between;
                                                
                                                Text {
                                                    text: "进度：" + book.progress + " / " + book.word_count;
                                                    font-size: 13px;
                                                    color: #909090;
                                                }
                                                
                                                Text {
                                                    text: "点击开始测验";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: #42A5F5;
                                                }
                                            }
                                        }
                                    }
                                }
                                
                                Rectangle {
                                    width: 80px;
                                    background: #22354A;
                                    border-top-right-radius: 12px;
                                    border-bottom-right-radius: 12px;
                                    
                                    TouchArea {
                                        clicked => {
                                            manage-book(index);
                                        }
                                        
                                        VerticalBox {
                                            alignment: center;
                                            spacing: 5px;
                                            
                                            Text {
                                                text: "⚙";
                                                font-size: 24px;
                                                horizontal-alignment: center;
                                                color: #42A5F5;
                                            }
                                            
                                            Text {
                                                text: "管理";
                                                font-size: 13px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                color: #42A5F5;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        
        
        // ======== 单词本管理界面 ========
        if show-book-manager: VerticalBox {
            spacing: 15px;

            HorizontalBox {
                alignment: space-between;

                Text {
                    text: "单词本管理";
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                    color: #E0E0E0;
                }

                HorizontalBox {
                    spacing: 10px;

                    Button {
                        text: "新建单词本";
                        primary: true;
                        clicked => {
                            new-book();
                        }
                    }

                    Button {
                        text: "导出";
                        clicked => {
                            export-books();
                        }
                    }

                    Button {
                        text: "导入";
                        clicked => {
                            import-books();
                        }
                    }

                    Button {
                        text: "恢复默认";
                        clicked => {
                            reset-all-books();
                        }
                    }

                    Button {
                        text: "返回";
                        clicked => {
                            close-book-manager();
                        }
                    }
                }
            }

            Rectangle {
                height: 2px;
                background: #3A3A3A;
            }

            Text {
                text: "提示：组合单词本只读，内容由所选来源本的单词并集构成，来源之间自动去重。";
                font-size: 14px;
                color: #B0B0B0;
                wrap: word-wrap;
            }

            if import-export-status != "": Rectangle {
                height: 48px;
                border-radius: 6px;
                background: #22354A;
                border-width: 1px;
                border-color: #42A5F5;

                HorizontalBox {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: "ℹ️";
                        font-size: 18px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: import-export-status;
                        font-size: 15px;
                        color: #E0E0E0;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }

                    TouchArea {
                        width: 32px;
                        height: 32px;
                        clicked => {
                            import-export-status = "";
                        }

                        Text {
                            text: "✕";
                            font-size: 18px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            color: #909090;
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: 15px;

                // 左：单词本列表
                Rectangle {
                    width: 42%;
                    border-radius: 8px;
                    background: #181B20;
                    border-width: 1px;
                    border-color: #404040;

                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "全部单词本（" + word-books.length + "）";
                            font-size: 16px;
                            font-weight: 600;
                            color: #E0E0E0;
                        }

                        ScrollView {
                            vertical-stretch: 1;

                            VerticalBox {
                                spacing: 8px;

                                for book[index] in word-books: Rectangle {
                                    height: 76px;
                                    border-radius: 8px;
                                    background: book-manager-edit-index == index ? #22354A : (manager-touch.has-hover ? #282D34 : #20242A);
                                    border-width: 1px;
                                    border-color: book-manager-edit-index == index ? #42A5F5 : #404040;

                                    manager-touch := TouchArea {
                                        clicked => {
                                            edit-book(index);
                                        }

                                        HorizontalBox {
                                            padding: 12px;
                                            spacing: 10px;

                                            VerticalBox {
                                                spacing: 4px;
                                                alignment: center;
                                                horizontal-stretch: 1;

                                                Text {
                                                    text: book.name;
                                                    font-size: 16px;
                                                    font-weight: 600;
                                                    color: #E0E0E0;
                                                }

                                                Text {
                                                    text: (book.is_composite ? "组合本 · " : "") + book.word_count + " 词";
                                                    font-size: 12px;
                                                    color: #909090;
                                                }
                                            }

                                            VerticalBox {
                                                width: 44px;
                                                alignment: center;

                                                Button {
                                                    width: 42px;
                                                    height: 40px;
                                                    text: "✕";
                                                    clicked => {
                                                        delete-book(index);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 右：编辑表单
                Rectangle {
                    border-radius: 8px;
                    background: #20242A;
                    border-width: 1px;
                    border-color: #404040;

                    VerticalBox {
                        padding: 20px;
                        spacing: 14px;

                        Text {
                            text: book-manager-edit-index >= 0 ? "编辑单词本" : "新建单词本";
                            font-size: 18px;
                            font-weight: 700;
                            color: #E0E0E0;
                        }

                        VerticalBox {
                            spacing: 8px;

                            Text {
                                text: "名称 *";
                                font-size: 14px;
                                font-weight: 600;
                                color: #B0B0B0;
                            }

                            LineEdit {
                                height: 42px;
                                horizontal-stretch: 1;
                                text <=> book-manager-name;
                                placeholder-text: "例如：考研核心词";
                                font-size: 16px;
                            }
                        }

                        VerticalBox {
                            spacing: 8px;

                            Text {
                                text: "描述";
                                font-size: 14px;
                                font-weight: 600;
                                color: #B0B0B0;
                            }

                            LineEdit {
                                height: 42px;
                                horizontal-stretch: 1;
                                text <=> book-manager-desc;
                                placeholder-text: "例如：每天 20 词";
                                font-size: 16px;
                            }
                        }

                        // 组合开关
                        HorizontalBox {
                            spacing: 10px;

                            if book-manager-composite: Button {
                                text: "✓ 组合本（按来源聚合）";
                                primary: true;
                                clicked => {
                                    book-manager-composite = false;
                                }
                            }

                            if !book-manager-composite: Button {
                                text: "设为组合本";
                                clicked => {
                                    book-manager-composite = true;
                                }
                            }
                        }

                        // 来源选择
                        if book-manager-composite: VerticalBox {
                            spacing: 8px;

                            Text {
                                text: "选择来源单词本";
                                font-size: 14px;
                                font-weight: 600;
                                color: #B0B0B0;
                            }

                            Rectangle {
                                height: 220px;
                                border-radius: 6px;
                                background: #181B20;
                                border-width: 1px;
                                border-color: #404040;

                                ScrollView {
                                    VerticalBox {
                                        padding: 8px;
                                        spacing: 6px;

                                        for source[index] in book-source-list: Rectangle {
                                            height: 42px;
                                            border-radius: 6px;
                                            background: source.checked ? #22354A : #20242A;
                                            border-width: 1px;
                                            border-color: source.checked ? #42A5F5 : #404040;

                                            source-touch := TouchArea {
                                                clicked => {
                                                    toggle-book-source(index);
                                                }

                                                HorizontalBox {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    spacing: 10px;

                                                    Text {
                                                        text: source.checked ? "☑" : "☐";
                                                        font-size: 18px;
                                                        vertical-alignment: center;
                                                        color: source.checked ? #42A5F5 : #909090;
                                                    }

                                                    Text {
                                                        text: source.name;
                                                        font-size: 15px;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        color: #E0E0E0;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: #3A3A3A;
                        }

                        HorizontalBox {
                            spacing: 10px;
                            alignment: center;

                            Button {
                                text: "保存";
                                primary: true;
                                enabled: book-manager-name != "";
                                clicked => {
                                    save-book();
                                }
                            }

                            Button {
                                text: "取消";
                                clicked => {
                                    close-book-manager();
                                }
                            }
                        }
                    }
                }
            }
        }
        // ======== 单词管理界面（带标签页）========
        if show-management: VerticalBox {
            spacing: 15px;
            
            HorizontalBox {
                spacing: 10px;
                alignment: space-between;
                
                Button {
                    text: "← 返回";
                    clicked => {
                        back-to-books-from-management();
                    }
                }
                
                Text {
                    text: current-book-name + " - 管理";
                    font-size: 20px;
                    font-weight: 700;
                    color: #E0E0E0;
                }
                
                Button {
                    text: "+ 添加新单词";
                    primary: true;
                    clicked => {
                        add-new-word();
                    }
                }
            }
            
            Rectangle {
                height: 2px;
                background: #3A3A3A;
            }
            
            TabWidget {
                // 标签页1: 单词编辑
                Tab {
                    title: "单词编辑";
                    
                    HorizontalBox {
                        spacing: 15px;
                        
                        Rectangle {
                            width: 40%;
                            border-radius: 8px;
                            background: #20242A;
                            border-width: 1px;
                            border-color: #404040;
                            
                            VerticalBox {
                                padding: 10px;
                                
                                Text {
                                    text: "单词列表（" + words-list.length + "）";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: #E0E0E0;
                                    padding-bottom: 10px;
                                }
                                
                                ScrollView {
                                    horizontal-stretch: 1;
                                    vertical-stretch: 1;

                                    VerticalBox {
                                        spacing: 10px;
                                        
                                        for word[index] in words-list: Rectangle {
                                            height: 108px;
                                            border-radius: 8px;
                                            background: selected-word-index == index ? #22354A : (word-touch.has-hover ? #282D34 : #20242A);
                                            border-width: 1px;
                                            border-color: selected-word-index == index ? #42A5F5 : #404040;
                                            
                                            word-touch := TouchArea {
                                                clicked => {
                                                    select-word(index);
                                                }
                                                
                                                HorizontalBox {
                                                    padding-left: 30px;
                                                    padding-right: 18px;
                                                    padding-top: 18px;
                                                    padding-bottom: 18px;
                                                    spacing: 14px;

                                                    VerticalBox {
                                                        spacing: 10px;
                                                        alignment: center;
                                                        horizontal-stretch: 1;
                                                        
                                                        Text {
                                                            text: word.answer;
                                                            font-size: 16px;
                                                            font-weight: 600;
                                                            color: #E0E0E0;
                                                        }
                                                        
                                                        Text {
                                                            text: word.meanings;
                                                            font-size: 13px;
                                                            color: #909090;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    
                                                    VerticalBox {
                                                        width: 46px;
                                                        alignment: center;

                                                        Button {
                                                            width: 44px;
                                                            height: 44px;
                                                            text: "✕";
                                                            clicked => {
                                                                delete-word(index);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        Rectangle {
                            border-radius: 8px;
                            background: #20242A;
                            border-width: 1px;
                            border-color: #404040;
                            
                            VerticalBox {
                                padding: 20px;
                                spacing: 15px;
                                
                                Text {
                                    text: selected-word-index >= 0 ? "编辑单词" : "添加新单词";
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: #E0E0E0;
                                }
                                
                                VerticalBox {
                                    spacing: 8px;
                                    
                                    Text {
                                        text: "英文单词 *";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #B0B0B0;
                                    }
                                    
                                    LineEdit {
                                        height: 44px;
                                        horizontal-stretch: 1;
                                        text <=> edit-answer;
                                        placeholder-text: "例如：scream";
                                        font-size: 16px;
                                    }
                                }
                                
                                VerticalBox {
                                    spacing: 8px;
                                    
                                    Text {
                                        text: "中文释义（用 \" / \" 分隔多个释义）*";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #B0B0B0;
                                    }
                                    
                                    LineEdit {
                                        height: 44px;
                                        horizontal-stretch: 1;
                                        text <=> edit-meanings;
                                        placeholder-text: "例如：高声喊 / 尖叫 / 呼啸";
                                        font-size: 16px;
                                    }
                                }
                                
                                VerticalBox {
                                    spacing: 8px;
                                    
                                    Text {
                                        text: "提示类型";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #B0B0B0;
                                    }
                                    
                                    HorizontalBox {
                                        spacing: 10px;
                                        
                                        Button {
                                            text: "中文释义";
                                            primary: edit-hint-type == "Meaning";
                                            clicked => {
                                                edit-hint-type = "Meaning";
                                            }
                                        }
                                        
                                        Button {
                                            text: "部分拼写";
                                            primary: edit-hint-type == "PartialSpell";
                                            clicked => {
                                                edit-hint-type = "PartialSpell";
                                            }
                                        }
                                        
                                        Button {
                                            text: "上下文";
                                            primary: edit-hint-type == "Context";
                                            clicked => {
                                                edit-hint-type = "Context";
                                            }
                                        }
                                    }
                                }
                                
                                Rectangle {
                                    height: 1px;
                                    background: #3A3A3A;
                                }
                                
                                HorizontalBox {
                                    spacing: 10px;
                                    alignment: center;
                                    
                                    Button {
                                        text: "保存";
                                        primary: true;
                                        enabled: edit-answer != "" && edit-meanings != "";
                                        clicked => {
                                            save-word();
                                        }
                                    }
                                    
                                    if selected-word-index >= 0: Button {
                                        text: "取消";
                                        clicked => {
                                            select-word(-1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                
                // 标签页2: 答题统计
                Tab {
                    title: "答题统计";
                    
                    VerticalBox {
                        spacing: 15px;
                        
                        // 汇总统计
                        Rectangle {
                            height: 100px;
                            border-radius: 8px;
                            background: #1A2F1A;
                            border-width: 2px;
                            border-color: #66BB6A;
                            
                            HorizontalBox {
                                padding: 20px;
                                spacing: 30px;
                                alignment: space-around;
                                
                                VerticalBox {
                                    spacing: 5px;
                                    alignment: center;
                                    
                                    Text {
                                        text: "总答题数";
                                        font-size: 14px;
                                        color: #909090;
                                    }
                                    
                                    Text {
                                        text: book-total-count;
                                        font-size: 28px;
                                        font-weight: 700;
                                        color: #E0E0E0;
                                    }
                                }
                                
                                VerticalBox {
                                    spacing: 5px;
                                    alignment: center;
                                    
                                    Text {
                                        text: "答对";
                                        font-size: 14px;
                                        color: #909090;
                                    }
                                    
                                    Text {
                                        text: book-correct-count;
                                        font-size: 28px;
                                        font-weight: 700;
                                        color: #66BB6A;
                                    }
                                }
                                
                                VerticalBox {
                                    spacing: 5px;
                                    alignment: center;
                                    
                                    Text {
                                        text: "答错";
                                        font-size: 14px;
                                        color: #909090;
                                    }
                                    
                                    Text {
                                        text: book-wrong-count;
                                        font-size: 28px;
                                        font-weight: 700;
                                        color: #EF5350;
                                    }
                                }
                                
                                VerticalBox {
                                    spacing: 5px;
                                    alignment: center;
                                    
                                    Text {
                                        text: "正确率";
                                        font-size: 14px;
                                        color: #909090;
                                    }
                                    
                                    Text {
                                        text: round(book-accuracy) + "%";
                                        font-size: 28px;
                                        font-weight: 700;
                                        color: #42A5F5;
                                    }
                                }
                            }
                        }
                        
                        HorizontalBox {
                            alignment: space-between;
                            
                            Text {
                                text: "单词详细统计（" + word-stats-list.length + "）";
                                font-size: 18px;
                                font-weight: 700;
                                color: #E0E0E0;
                            }
                            
                            Button {
                                text: "重置所有统计";
                                clicked => {
                                    reset-book-stats();
                                }
                            }
                        }
                        
                        // 单词统计列表
                        ScrollView {
                            VerticalBox {
                                spacing: 8px;
                                
                                for stats in word-stats-list: Rectangle {
                                    height: 80px;
                                    border-radius: 8px;
                                    background: stats.is_weak ? #FFEBEE : #FFFFFF;
                                    border-width: 1px;
                                    border-color: stats.is_weak ? #EF5350 : #E0E0E0;
                                    
                                    HorizontalBox {
                                        padding: 15px;
                                        spacing: 15px;
                                        
                                        // 单词信息
                                        VerticalBox {
                                            width: 150px;
                                            spacing: 5px;
                                            alignment: start;
                                            
                                            Text {
                                                text: stats.word;
                                                font-size: 18px;
                                                font-weight: 700;
                                                color: #E0E0E0;
                                            }
                                            
                                            if stats.is_weak: Text {
                                                text: "⚠ 薄弱单词";
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: #EF5350;
                                            }
                                        }
                                        
                                        // 统计数据
                                        HorizontalBox {
                                            spacing: 20px;
                                            
                                            VerticalBox {
                                                spacing: 2px;
                                                
                                                Text {
                                                    text: "出现";
                                                    font-size: 12px;
                                                    color: #909090;
                                                }
                                                
                                                Text {
                                                    text: stats.total_count;
                                                    font-size: 20px;
                                                    font-weight: 600;
                                                    color: #E0E0E0;
                                                }
                                            }
                                            
                                            VerticalBox {
                                                spacing: 2px;
                                                
                                                Text {
                                                    text: "答对";
                                                    font-size: 12px;
                                                    color: #909090;
                                                }
                                                
                                                Text {
                                                    text: stats.correct_count;
                                                    font-size: 20px;
                                                    font-weight: 600;
                                                    color: #66BB6A;
                                                }
                                            }
                                            
                                            VerticalBox {
                                                spacing: 2px;
                                                
                                                Text {
                                                    text: "答错";
                                                    font-size: 12px;
                                                    color: #909090;
                                                }
                                                
                                                Text {
                                                    text: stats.wrong_count;
                                                    font-size: 20px;
                                                    font-weight: 600;
                                                    color: #EF5350;
                                                }
                                            }
                                            
                                            VerticalBox {
                                                spacing: 2px;
                                                
                                                Text {
                                                    text: "正确率";
                                                    font-size: 12px;
                                                    color: #909090;
                                                }
                                                
                                                Text {
                                                    text: round(stats.accuracy) + "%";
                                                    font-size: 20px;
                                                    font-weight: 600;
                                                    color: #42A5F5;
                                                }
                                            }
                                        }
                                        
                                        Rectangle {}
                                        
                                        // 操作按钮
                                        Button {
                                            text: "重置";
                                            clicked => {
                                                reset-word-stats(stats.word);
                                            }
                                        }
                                    }
                                }
                                
                                if word-stats-list.length == 0: Text {
                                    text: "暂无答题数据，开始测验后这里会显示详细统计";
                                    font-size: 16px;
                                    color: #707070;
                                    horizontal-alignment: center;
                                    padding: 40px;
                                }
                            }
                        }
                    }
                }
            }
        }
        
        // ======== 测验界面 ========
        if show-quiz: VerticalBox {
            spacing: 15px;
            
            HorizontalBox {
                spacing: 10px;
                
                Button {
                    text: "← 返回选择";
                    clicked => {
                        back-to-books();
                    }
                }
                
                Rectangle { }
                
                HorizontalBox {
                    spacing: 10px;
                    
                    Text {
                        text: "连续答对";
                        font-size: 16px;
                        color: #B0B0B0;
                        vertical-alignment: center;
                    }
                    
                    Text {
                        text: score;
                        font-size: 28px;
                        font-weight: 700;
                        color: #42A5F5;
                    }
                }
            }
            
            Rectangle {
                height: 2px;
                background: #3A3A3A;
            }
            
            Rectangle {
                border-radius: 12px;
                background: #20242A;
                border-width: 2px;
                border-color: quiz-active ? #42A5F5 : #404040;
                min-height: 250px;
                
                VerticalBox {
                    padding: 24px;
                    spacing: 20px;
                    alignment: center;
                    
                    if quiz-active: Text {
                        text: "第 " + (score + 1) + " 题";
                        font-size: 16px;
                        color: #42A5F5;
                        font-weight: 600;
                    }
                    
                    Rectangle {
                        min-height: 90px;
                        background: #20242A;
                        border-radius: 8px;
                        border-width: 2px;
                        border-color: #404040;
                        
                        Text {
                            text: current-tip;
                            font-size: 26px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            color: #E0E0E0;
                        }
                    }
                    
                    if quiz-active: VerticalBox {
                        spacing: 10px;
                        
                        Text {
                            text: "请输入英文单词：";
                            font-size: 16px;
                            color: #B0B0B0;
                            font-weight: 600;
                        }
                        
                        LineEdit {
                            height: 48px;
                            horizontal-stretch: 1;
                            placeholder-text: "输入答案并按 Enter...";
                            text <=> user-input;
                            font-size: 22px;
                            enabled: !show-feedback;

                            accepted(text) => {
                                submit-answer(text);
                            }
                        }
                    }
                    
                    if !quiz-active: Text {
                        text: "👆 点击下方按钮开始测验";
                        font-size: 18px;
                        color: #707070;
                    }
                }
            }
            
            if show-feedback: Rectangle {
                border-radius: 12px;
                background: is-correct ? #1A2F1A : #3A1B1B;
                border-width: 3px;
                border-color: is-correct ? #66BB6A : #EF5350;
                
                VerticalBox {
                    padding: 20px;
                    spacing: 12px;
                    
                    Text {
                        text: "结果";
                        font-size: 16px;
                        font-weight: 700;
                        color: #E0E0E0;
                    }
                    
                    Text {
                        text: feedback;
                        font-size: 18px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        color: is-correct ? #66BB6A : #E57373;
                        wrap: word-wrap;
                    }
                    
                    if !is-correct: Text {
                        text: "继续努力！";
                        font-size: 15px;
                        horizontal-alignment: center;
                        color: #909090;
                    }
                }
            }
            
            HorizontalBox {
                spacing: 10px;
                alignment: center;
                
                if !quiz-active: Button {
                    text: "开始测验";
                    primary: true;
                    clicked => {
                        start-quiz();
                    }
                }
                
                if quiz-active && !show-feedback: Button {
                    text: "提交答案";
                    primary: true;
                    clicked => {
                        submit-answer(user-input);
                    }
                }
                
                if show-feedback && is-correct: Button {
                    text: "下一题";
                    primary: true;
                    clicked => {
                        next-question();
                    }
                }
                
                if show-feedback && !is-correct: Button {
                    text: "重新开始";
                    clicked => {
                        start-quiz();
                    }
                }
            }
        }
    }
}
